# PLAN-A Memo 빌드 환경 값 — Rust 쪽은 "빌드할 때" 읽는다(option_env!).
#
#   권장:  npm run dist:staging   /   npm run dist:production   (scripts/dist.mjs 가 아래 값을 맞춰 준다)
#
# 변수 이름은 PLANA_ENV 다(밑줄 없음). PLAN_A_ENV 를 주면 빌드가 멈춘다(예전에는 조용히 production 이 됐다).
# 비어 있으면: debug 빌드 = development, release 빌드 = production.
# staging 은 앱 식별자 com.plana.memo.staging(src-tauri/tauri.staging.conf.json)으로만 빌드된다 — 운영 설치와 공존.
PLANA_ENV=

# PLAN-A Work 주소(origin 만 — API 경로는 memo-sync-v1 Contract 대로 코드에 있다).
#   production  기본 https://planawork.com
#   staging     기본 https://staging.planawork.com
#   development 기본 없음 → 개발용 Mock 서버
# 운영·staging 빌드에는 https 주소만 넣을 수 있다(127.0.0.1·localhost·http 는 거절 → 기본값 사용).
# 운영 주소(planawork.com)는 운영 빌드에서만 — 개발·staging 빌드에 넣으면 거절(→ 개발은 Mock, staging 은 staging 기본값).
# 개발 빌드는 서버 namespace 가 local·staging 일 때만 credential 을 저장한다(운영 서버 시험 금지).
# development 빌드는 실행할 때의 같은 이름 환경 변수도 읽는다(예: 로컬 Backend http://127.0.0.1:8000).
PLANA_SERVER_ORIGIN=

# ── 앱 업데이트(Tauri Updater) — docs/release.md ──────────────────────────
# 업데이트 파일을 올리는 곳(끝의 / 없이). 앱은 <이 주소>/<채널>/latest.json 을 확인한다.
#   예: https://downloads.example.com/plan-a-memo   → production 앱은 .../production/latest.json
# 채널 공개키는 src-tauri/updater/<채널>.pub (커밋). 둘 중 하나라도 없으면 업데이트 확인이 꺼진 빌드가 된다.
PLANA_UPDATE_BASE_URL=

# 서명 개인키 — **이 파일·저장소에 적지 않는다.** 빌드 PC 의 환경 변수(또는 CI 비밀값)로만 준다.
#   PowerShell: $env:TAURI_SIGNING_PRIVATE_KEY = Get-Content "$HOME\.plan-a-memo-keys\production.key" -Raw
#               $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD = "<비밀번호>"
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# (scripts/dist.mjs 가 자동으로 넣는 값 — 직접 줄 필요 없음)
#   PLANA_UPDATE_ENDPOINT  = <PLANA_UPDATE_BASE_URL>/<채널>/latest.json
#   PLANA_UPDATER_PUBKEY   = src-tauri/updater/<채널>.pub 내용

# (프런트엔드) 붙여넣기 진단 패널 — Web 공용 편집기 코드의 QA 옵션. 개발 빌드에서만 의미가 있다.
VITE_ENABLE_PASTE_DIAGNOSTICS=
