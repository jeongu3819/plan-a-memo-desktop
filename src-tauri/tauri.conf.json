{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLAN-A Memo",
  "mainBinaryName": "PLAN-A Memo",
  "version": "0.2.2",
  "identifier": "com.plana.memo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PLAN-A Memo",
        "width": 1100,
        "height": 780,
        "minWidth": 850,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://attachment.localhost attachment: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://attachment.localhost attachment: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PLAN-A",
    "shortDescription": "PLAN-A Memo",
    "longDescription": "PLAN-A Work 개인 메모장과 같은 화면의 Windows 로컬 메모 프로그램",
    "category": "Productivity",
    "copyright": "PLAN-A",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Korean", "English"],
        "startMenuFolder": "PLAN-A Memo"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["plana-memo"]
      }
    }
  }
}
